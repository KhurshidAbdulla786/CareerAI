# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/career-ai

# JWT
JWT_SECRET=careerai786
JWT_EXPIRE=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (Nodemailer) - use Gmail App Password for SMTP_USER/SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareerAI <no-reply@careerai.app>

# Stripe test keys (Get from https://dashboard.stripe.com/test/apikeys)
# Use real test keys; placeholders will cause "Invalid API Key" errors.
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_me
# Stripe Price IDs (Create products at https://dashboard.stripe.com/test/products)
STRIPE_PRICE_ID_MONTHLY=price_placeholder_monthly
STRIPE_PRICE_ID_YEARLY=price_placeholder_yearly

# eSewa test keys (Already configured for test mode)
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_MERCHANT_SECRET=8gBm/:&EnhH.1/q
